{
  "name": "@cera/observability",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Structured logging with allow-list redaction, request ID propagation, and GlitchTip helpers",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "default": "./src/logger.ts"
    },
    "./redact": {
      "types": "./src/redact.ts",
      "default": "./src/redact.ts"
    },
    "./request-id": {
      "types": "./src/request-id.ts",
      "default": "./src/request-id.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./glitchtip": {
      "types": "./src/glitchtip.ts",
      "default": "./src/glitchtip.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@cera/contracts": "workspace:*",
    "@sentry/node": "catalog:",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@cera/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
