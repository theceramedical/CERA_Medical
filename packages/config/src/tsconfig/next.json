{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "CERA Next.js application",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node"],
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "plugins": [{ "name": "next" }]
  },
  "exclude": ["node_modules", ".next", "dist", "coverage"]
}
