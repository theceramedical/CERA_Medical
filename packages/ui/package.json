{
  "name": "@cera/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "//exports": "Subpath exports rather than one barrel. A barrel means importing Button pulls in every component and, more importantly, defeats tree-shaking in apps/web - the whole library ends up in the first-load bundle of every route.",
  "exports": {
    "./styles/theme.css": "./src/styles/theme.css",
    "./cn": "./src/cn.ts",
    "./tokens": "./src/tokens.ts",
    "./contrast": "./src/contrast.ts",
    "./typography": "./src/typography.tsx",
    "./alert": "./src/alert.tsx",
    "./badge": "./src/badge.tsx",
    "./breadcrumbs": "./src/breadcrumbs.tsx",
    "./button": "./src/button.tsx",
    "./card": "./src/card.tsx",
    "./choice": "./src/choice.tsx",
    "./divider": "./src/divider.tsx",
    "./empty-state": "./src/empty-state.tsx",
    "./field": "./src/field.tsx",
    "./focus-trap": "./src/focus-trap.tsx",
    "./icon-disc": "./src/icon-disc.tsx",
    "./input": "./src/input.tsx",
    "./link": "./src/link.tsx",
    "./pagination": "./src/pagination.tsx",
    "./skeleton": "./src/skeleton.tsx",
    "./skip-link": "./src/skip-link.tsx",
    "./spinner": "./src/spinner.tsx",
    "./table": "./src/table.tsx",
    "./toast": "./src/toast.tsx",
    "./visually-hidden": "./src/visually-hidden.tsx"
  },
  "scripts": {
    "//lint": "Whole package, not just src. The pre-commit hook lints staged files wherever they are, so a script scoped to src/ lets the hook fail on a file the package's own lint call never looked at - which is how vitest.setup.ts reached a commit with a parse error.",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:contrast": "vitest run src/contrast"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@cera/config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "//peerDependencies": "A range, not the catalog pin. The catalog resolves to an exact version, and an exact peer range makes any React patch bump in apps/web report an unmet peer for a library that is built from source in the same repository.",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
