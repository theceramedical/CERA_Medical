# =============================================================================
# CERA Medical platform - environment contract (FND-005)
# =============================================================================
#
# PLACEHOLDERS ONLY. Never commit a real value to this file.
# PRD section 15: the repository may hold names, safe defaults, schema, and
# documentation. Passwords, API keys, tokens, private keys, customer data, and
# production dumps are prohibited.
#
# Copy to .env (git-ignored) and fill in locally:
#     cp .env.example .env
#
# The authoritative definition of every variable below is the Zod schema in
# packages/config/src/env/index.js. A test asserts that this file and that
# schema describe the same variable set, so the two cannot drift.
#
# Generate the secrets marked GENERATE with:
#     openssl rand -base64 48
# =============================================================================


# -----------------------------------------------------------------------------
# Common
# -----------------------------------------------------------------------------
NODE_ENV=development
CERA_ENV=local
LOG_LEVEL=debug
RELEASE=dev
# Public domain used by the production Caddy edge. Set to your owned domain before release.
CERA_DOMAIN=localhost
CADDY_ACME_EMAIL=you@example.com


# -----------------------------------------------------------------------------
# PostgreSQL
# One instance, five databases, five least-privilege roles. No role can reach
# another database. See .planning/architecture.md section 5.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace-me-local-only

CERA_APP_DB=cera_app
CERA_APP_DB_USER=cera_app
CERA_APP_DB_PASSWORD=replace-me-local-only

CERA_CMS_DB=cera_cms
CERA_CMS_DB_USER=cera_cms
CERA_CMS_DB_PASSWORD=replace-me-local-only

CERA_COMMERCE_DB=cera_commerce
CERA_COMMERCE_DB_USER=cera_commerce
CERA_COMMERCE_DB_PASSWORD=replace-me-local-only

AUTHENTIK_DB=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=replace-me-local-only

GLITCHTIP_DB=glitchtip
GLITCHTIP_DB_USER=glitchtip
GLITCHTIP_DB_PASSWORD=replace-me-local-only

DATABASE_URL=postgres://cera_app:replace-me-local-only@localhost:5432/cera_app
DATABASE_POOL_MAX=10


# -----------------------------------------------------------------------------
# Valkey
# -----------------------------------------------------------------------------
VALKEY_URL=redis://localhost:6379/0
VALKEY_HOST=localhost
VALKEY_PORT=6379


# -----------------------------------------------------------------------------
# apps/web
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3003
CMS_URL=http://localhost:3001

# GENERATE. Seals the JWE session cookie (ADR-004). Rotating this signs
# everyone out, so rotation uses an overlap window in staging and production.
SESSION_SECRET=GENERATE-32-plus-bytes-base64


# -----------------------------------------------------------------------------
# apps/api
# -----------------------------------------------------------------------------
API_PORT=3003
CORS_ALLOWED_ORIGINS=http://localhost:3000
VENDURE_SHOP_API_URL=http://localhost:3002/shop-api
# Cart/checkout BFF (ADR-011). Set true on api, commerce, and web together.
CHECKOUT_ENABLED=false
NEXT_PUBLIC_CHECKOUT_ENABLED=false
# Production card payments (commerce). Local uses cera-test-payment when unset.
STRIPE_SECRET_KEY=
CMS_API_URL=http://localhost:3001/api

RATE_LIMIT_ENQUIRY_PER_IP_HOUR=10
RATE_LIMIT_ENQUIRY_PER_EMAIL_HOUR=5

# GENERATE. Salts the rate-limit IP hash. Raw IP addresses are never stored on
# an enquiry record (PRD 10, Privacy).
IP_HASH_SALT=GENERATE-random-string


# -----------------------------------------------------------------------------
# Identity - Authentik OIDC (ADR-004)
# Separate clients per environment. A local credential must never be valid
# against staging or production (PRD 15).
# -----------------------------------------------------------------------------
OIDC_ISSUER=http://localhost:9000/application/o/cera-local/
OIDC_JWKS_URI=http://localhost:9000/application/o/cera-local/jwks/
OIDC_CLIENT_ID=replace-with-authentik-client-id
OIDC_CLIENT_SECRET=replace-with-authentik-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# GENERATE with: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=GENERATE-60-bytes-base64
AUTHENTIK_BOOTSTRAP_PASSWORD=replace-me-local-only
AUTHENTIK_BOOTSTRAP_EMAIL=admin@cera.localhost


# -----------------------------------------------------------------------------
# apps/cms - Payload
# -----------------------------------------------------------------------------
CMS_PORT=3001
# Separate from DATABASE_URL (cera_app). Payload must never migrate the app database.
CMS_DATABASE_URL=postgres://cera_cms:replace-me-local-only@localhost:5432/cera_cms
PAYLOAD_SECRET=GENERATE-32-plus-bytes-base64
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
PAYLOAD_PREVIEW_SECRET=GENERATE-random-string
WEB_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# apps/commerce - Vendure
# -----------------------------------------------------------------------------
COMMERCE_PORT=3002
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-me-local-only
COOKIE_SECRET=GENERATE-32-plus-bytes-base64
ASSET_URL_PREFIX=http://localhost:3002/assets/


# -----------------------------------------------------------------------------
# apps/worker - outbox and integrations
# -----------------------------------------------------------------------------
WORKER_PORT=3004
OUTBOX_BATCH_SIZE=25
OUTBOX_SWEEP_INTERVAL_MS=15000
OUTBOX_MAX_ATTEMPTS=8


# -----------------------------------------------------------------------------
# Provider drivers - the sandbox-first switch
# Real credentials drop in here with no code change. Locally: smtp -> Mailpit,
# s3 -> MinIO, fake -> in-memory CRM.
#   EMAIL_DRIVER   fake | smtp | resend
#   CRM_DRIVER     fake | erpnext
#   STORAGE_DRIVER fake | local | s3
# -----------------------------------------------------------------------------
EMAIL_DRIVER=smtp
CRM_DRIVER=fake
STORAGE_DRIVER=s3

# Email
SMTP_URL=smtp://localhost:1025
# Quoted because the value contains spaces and angle brackets. Compose tolerates
# it unquoted; shell tooling that reads this file does not.
EMAIL_FROM="CERA Medical <noreply@cera.localhost>"
EMAIL_STAFF_ALERT_TO=operations@cera.localhost
RESEND_API_KEY=
# Svix whsec_... signing secret. Verified over the RAW body (ADR-007).
RESEND_WEBHOOK_SECRET=replace-with-resend-webhook-secret

# CRM - ERPNext REST API. Create a dedicated integration user with Lead read,
# create, and write permission and four custom_cera_* Lead fields; see runbook.
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# Object storage - MinIO locally, Cloudflare R2 in staging and production.
# R2 requires region 'auto' and a custom endpoint.
S3_ENDPOINT=http://localhost:9001
S3_REGION=auto
S3_BUCKET=cera-media
S3_ACCESS_KEY_ID=replace-me-local-only
S3_SECRET_ACCESS_KEY=replace-me-local-only
S3_PUBLIC_URL=http://localhost:9001/cera-media
MINIO_ROOT_USER=replace-me-local-only
MINIO_ROOT_PASSWORD=replace-me-local-only


# -----------------------------------------------------------------------------
# Observability - self-hosted GlitchTip
# Leave DSN empty locally to disable reporting. GLITCHTIP_DOMAIN must include
# the scheme.
# -----------------------------------------------------------------------------
GLITCHTIP_DSN=
GLITCHTIP_DOMAIN=http://localhost:8080
GLITCHTIP_SECRET_KEY=GENERATE-32-bytes-hex
GLITCHTIP_MAX_EVENT_LIFE_DAYS=30


# -----------------------------------------------------------------------------
# Backups
# Public-key encryption means the backup host holds no decryption key.
# -----------------------------------------------------------------------------
BACKUP_AGE_PUBLIC_KEY=
BACKUP_RETENTION_DAYS=14
BACKUP_TARGET_DIR=./backups
