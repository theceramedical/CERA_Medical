# Fail at install time when the local Node or pnpm version is wrong, instead of
# surfacing as a confusing runtime error later.
engine-strict=true

# Runtime dependencies are pinned exactly. PRD section 10 requires pinned tool
# versions and locked dependencies, and the immutable-image promotion model in
# PRD 14 depends on reproducible builds.
save-exact=true

# Surface phantom dependencies during development rather than in a container
# build, where the node_modules layout differs.
shamefully-hoist=false
strict-peer-dependencies=false

# Reproducible installs.
prefer-frozen-lockfile=true
resolution-mode=highest

# Only these packages may run install scripts. Anything else is a supply-chain
# review item, per the OWASP 2025 supply-chain control in Phase 14.
enable-pre-post-scripts=false
