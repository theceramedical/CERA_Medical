#!/usr/bin/env sh
# Catches what lint-staged cannot see: a type error caused by a change in
# another file. Runs on push rather than commit so local iteration stays fast.
set -e

echo "[pre-push] typecheck"
pnpm -r typecheck

echo "[pre-push] unit tests"
pnpm -r test:unit

# Auto-deploy to Cloudflare Pages whenever pushing to main
current_branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$current_branch" = "main" ]; then
  echo "[pre-push] Branch is main: Auto-deploying to Cloudflare Pages (cera-web)..."
  node scripts/deploy-cloudflare.mjs
fi
