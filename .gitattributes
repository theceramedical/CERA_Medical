# Normalise line endings so a Windows checkout and a Linux container agree.
# Shell scripts must stay LF or they fail inside the image with a confusing
# "bad interpreter" error.
* text=auto eol=lf

*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
Caddyfile text eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.dump binary

pnpm-lock.yaml -diff linguist-generated=true
