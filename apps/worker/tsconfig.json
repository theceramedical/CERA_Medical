{
  "//": "Editor and lint configuration. Includes tests so typed ESLint rules work on them. Emit uses tsconfig.build.json.",
  "extends": "@cera/config/tsconfig/node",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
