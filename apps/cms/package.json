{
  "name": "cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Payload 3 editorial admin and published-content API for CERA Medical",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "pnpm generate:importmap && next build",
    "start": "next start --port 3001",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "//migrate": "push and migrate are mutually exclusive. This script is the only path that runs migrations; payload.config.ts keeps push off whenever PAYLOAD_PUSH is not '1'.",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed": "node --experimental-strip-types src/seed.ts",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@cera/config": "workspace:*",
    "@cera/contracts": "workspace:*",
    "@cera/observability": "workspace:*",
    "@payloadcms/db-postgres": "catalog:",
    "@payloadcms/next": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/storage-s3": "catalog:",
    "graphql": "catalog:",
    "next": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
