{
  "name": "commerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vendure 3.7 service catalogue with checkout neutralised (ADR-005)",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "dev:worker": "node --watch --experimental-strip-types src/index-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/index-worker.js",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:contract": "vitest run tests/contract",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "seed": "node --experimental-strip-types src/seed.ts",
    "denied-fields": "node --experimental-strip-types src/scripts/derive-denied-fields.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@cera/config": "workspace:*",
    "@cera/contracts": "workspace:*",
    "@vendure/asset-server-plugin": "catalog:",
    "@vendure/core": "catalog:",
    "@vendure/dashboard": "catalog:",
    "@vendure/harden-plugin": "catalog:",
    "@vendure/job-queue-plugin": "catalog:",
    "bullmq": "catalog:",
    "graphql": "catalog:",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
